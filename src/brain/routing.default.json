{
  "version": 4,
  "defaults": {
    "toolBudget": 20,
    "maxIterations": 30,
    "compactionTokens": 80000
  },
  "_enterpriseNote": "v2 (2026-05-12): removed all Chinese-origin model providers (DeepSeek, Kimi/Moonshot, Qwen) for enterprise compliance. Default fleet is US/EU only: Anthropic, Google, xAI, OpenAI, Mistral (FR), Groq (US infra w/ Llama+gpt-oss).",
  "_routingThesis": "v4 (2026-06): refreshed to latest frontier — Opus 4.8 ($5/$25, down from $15/$75), Sonnet 4.6 ($3/$15) workhorse, Grok 4.3 ($1.25/$2.50, 1M ctx) cheap-frontier reasoner, Gemini 3.5 Flash ($1.50/$9) for reads, GPT-5.x as cross-vendor fallbacks. Frontier-on-demand: Sonnet 4.6 executes, Opus 4.8 plans complex work, cheap models reserved for reads/classifier/review/trivial. Cost story still rests on caching + precise retrieval, not on dropping to weak models. Savings anchor is the customer's own baseline (see docs/PRODUCT_DEFINITION.md), not Opus list price.",
  "routes": {
    "question": {
      "model": "gemini-3.5-flash",
      "fallbacks": ["claude-haiku-4-5", "mistral-small"],
      "toolBudget": 3,
      "maxIterations": 4,
      "needsPlan": false
    },
    "edit_small": {
      "model": "claude-sonnet-4-6",
      "fallbacks": ["gemini-3.1-pro", "grok-4.3"],
      "toolBudget": 10,
      "maxIterations": 15,
      "needsPlan": false
    },
    "edit_multi": {
      "model": "claude-sonnet-4-6",
      "fallbacks": ["gemini-3.1-pro", "grok-4.3"],
      "toolBudget": 20,
      "maxIterations": 25,
      "needsPlan": false
    },
    "refactor": {
      "model": "claude-sonnet-4-6",
      "planModel": "claude-opus-4-8",
      "fallbacks": ["gemini-3.1-pro", "gpt-5.4"],
      "toolBudget": 30,
      "maxIterations": 40,
      "needsPlan": true
    },
    "debug": {
      "model": "grok-4.3",
      "fallbacks": ["claude-sonnet-4-6", "gemini-3.1-pro"],
      "toolBudget": 25,
      "maxIterations": 30,
      "needsPlan": false,
      "providerOptions": { "reasoning": { "enabled": true } }
    },
    "scaffold": {
      "model": "claude-sonnet-4-6",
      "planModel": "grok-4.3",
      "planProviderOptions": { "reasoning": { "enabled": true } },
      "fallbacks": ["gemini-3.1-pro", "gpt-5.4"],
      "toolBudget": 15,
      "maxIterations": 20,
      "needsPlan": true
    },
    "review": {
      "model": "gemini-3.5-flash",
      "fallbacks": ["claude-haiku-4-5", "claude-sonnet-4-6"],
      "toolBudget": 5,
      "maxIterations": 6,
      "needsPlan": false
    },
    "explain": {
      "model": "gemini-3.5-flash",
      "fallbacks": ["claude-haiku-4-5", "mistral-small"],
      "toolBudget": 0,
      "maxIterations": 2,
      "needsPlan": false
    }
  },
  "complexityOverrides": {
    "complex": {
      "model": "claude-opus-4-8",
      "planModel": "claude-opus-4-8",
      "providerOptions": { "reasoning": { "enabled": true } }
    },
    "moderate": {},
    "simple": {},
    "trivial": {
      "model": "mistral-small"
    }
  },
  "writeCode": {
    "model": "claude-sonnet-4-6",
    "fallbacks": ["gemini-3.1-pro", "gpt-5.4"]
  },
  "embedding": {
    "model": "embedding-small"
  },
  "classifier": {
    "model": "mistral-small",
    "timeoutMs": 4000,
    "weights": {
      "fileCount": 0.35,
      "taskLength": 0.15,
      "verbComplex": 0.25,
      "pastSuccess": -0.25,
      "hasMultipleFiles": 0.2,
      "mentionsTest": 0.1,
      "deepQuestion": 0.15,
      "topFileMention": 0.2,
      "contextualFollowup": 0.1
    }
  }
}
